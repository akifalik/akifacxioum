@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{ Layout = "_Layout"; ViewData["Title"] = "Opportunities"; var stages = AcxiomCRM.Models.Rules.Stages; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Opportunities</h2>
  <a asp-action="Create" class="btn btn-primary">+ Add Opportunity</a>
</div>
<form method="get" class="mb-3 d-flex gap-2 flex-wrap">
  <input name="q" value="@Context.Request.Query["q"]" class="form-control" style="max-width:280px" placeholder="Search opportunity name..." />
  <select name="stage" class="form-select" style="max-width:180px">
    <option value="">All Stages</option>
    @foreach (var s in stages) {
      <option value="@s" selected="@(Context.Request.Query["stage"]==s)">@s</option>
    }
  </select>
  <button class="btn btn-outline-secondary">Filter</button>
</form>
<div class="table-responsive">
  <table class="table table-hover table-striped">
    <thead class="table-dark">
      <tr><th>Name</th><th>Amount (₹)</th><th>Stage</th><th>Probability</th><th>Close Date</th><th>Status</th><th>Created</th></tr>
    </thead>
    <tbody>
      @foreach (var o in Model) {
        <tr>
          <td>@o.OpportunityName</td>
          <td>@o.Amount.ToString("N0")</td>
          <td><span class="badge bg-primary">@o.Stage</span></td>
          <td>@o.Probability%</td>
          <td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
          <td><span class="badge @(o.Status=="Open"?"bg-success":"bg-secondary")">@o.Status</span></td>
          <td>@o.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td>
        </tr>
      }
    </tbody>
  </table>
  @if (!Model.Any()) {
    <p class="text-muted text-center">No opportunities found.</p>
  }
</div>
