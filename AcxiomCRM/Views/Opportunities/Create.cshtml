@model AcxiomCRM.Models.Opportunity
@{ Layout = "_Layout"; ViewData["Title"] = "Add Opportunity"; var stages = AcxiomCRM.Models.Rules.Stages; }
<div class="row justify-content-center">
  <div class="col-md-6">
    <h2 class="mb-3">Add Opportunity</h2>
    <form asp-action="Create" method="post">
      <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
      <div class="mb-3">
        <label asp-for="OpportunityName" class="form-label"></label>
        <input asp-for="OpportunityName" class="form-control" />
        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="CustomerId" class="form-label">Customer ID</label>
        <input asp-for="CustomerId" type="number" class="form-control" />
        <span asp-validation-for="CustomerId" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Amount" class="form-label">Amount (₹)</label>
        <input asp-for="Amount" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Stage" class="form-label"></label>
        <select asp-for="Stage" class="form-select">
          @foreach (var s in stages) { <option value="@s">@s</option> }
        </select>
        <span asp-validation-for="Stage" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Probability" class="form-label">Probability (%)</label>
        <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
        <span asp-validation-for="Probability" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="ExpectedCloseDate" class="form-label"></label>
        <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
