@model IEnumerable<AcxiomCRM.Models.Customer>
@{ Layout = "_Layout"; ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Customers</h2>
  <a asp-action="Create" class="btn btn-primary">+ Add Customer</a>
</div>
<form method="get" class="mb-3 d-flex gap-2">
  <input name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Search name, email, phone, company..." />
  <button class="btn btn-outline-secondary">Search</button>
</form>
<div class="table-responsive">
  <table class="table table-hover table-striped">
    <thead class="table-dark">
      <tr>
        <th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th>Created</th><th></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var c in Model) {
        <tr>
          <td>@c.CustomerCode</td>
          <td>@c.CustomerName</td>
          <td>@c.Email</td>
          <td>@c.Phone</td>
          <td>@c.CompanyName</td>
          <td><span class="badge @(c.Status=="Active"?"bg-success":"bg-secondary")">@c.Status</span></td>
          <td>@c.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td>
          <td>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager")) {
              <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post"
                    onsubmit="return confirm('Deactivate this customer?')">
                <button class="btn btn-sm btn-outline-danger">Deactivate</button>
              </form>
            }
          </td>
        </tr>
      }
    </tbody>
  </table>
  @if (!Model.Any()) {
    <p class="text-muted text-center">No customers found.</p>
  }
</div>
