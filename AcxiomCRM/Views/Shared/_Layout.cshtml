<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AcxiomCRM</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body><nav class="navbar navbar-dark bg-dark px-3"><a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">AcxiomCRM</a>
<div class="d-flex gap-3">
@if (User.Identity?.IsAuthenticated == true) {
  <a class="text-light" asp-controller="Customers" asp-action="Index">Customers</a>
  <a class="text-light" asp-controller="Opportunities" asp-action="Index">Opportunities</a>
  <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Logout</button></form>
}</div></nav><main class="container py-4">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)</body></html>
